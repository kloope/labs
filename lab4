class Score {
public:
    int points;
    Score(int p = 0) : points(p) {}
    int mark() const { return points / 10; } 
    bool operator<(const Score& o) const { return points < o.points; }
    bool operator==(const Score& o) const { return points == o.points; }
    static const char* header() { return "№\tБаллы\tОценка"; }
    void printRow(ostream& o, int n) const { o << n << "\t" << points << "\t" << mark() << "\n"; }
    bool matches(const string& p) const { return to_string(points).find(p) != string::npos; }
    void edit() { points = inputInt("Новые баллы: "); }
    bool sortLess(const Score& o) const { return points > o.points; } // по убыванию
    string fields() const { return to_string(points); }
    static bool create(Score& x) { x.points = inputInt("Баллы (0-100): "); return true; }
    static bool load(const vector<string>& f, Score& x) {
        if (f.empty()) return false;
        x = Score(stoi(f[0]));
        return true;
    }
};
struct ScoreHash { size_t operator()(const Score& s) const { return hash<int>()(s.points); } };

class TestResult {
public:
    static map<int, Student>* pool;
    Student* student;               
    string date;
    Score score;                    
    TestResult() : student(nullptr) {}
    string key() const { return student->language; }
    static const char* header() { return "№\tСтудент\tЯзык\tДата\tБаллы\tОценка"; }
    void printRow(ostream& o, int n) const {
        o << n << "\t" << student->getName() << "\t" << student->language << "\t"
            << date << "\t" << score.points << "\t" << score.mark() << "\n";
    }
    bool matches(const string& p) const { return student->matches(p); }
    void edit() { date = input("Новая дата: "); score.points = inputInt("Новые баллы: "); }
    bool sortLess(const TestResult& o) const { return score.points > o.score.points; }
    string fields() const { return to_string(student->id) + "|" + date + "|" + to_string(score.points); }
    static bool create(TestResult& x) {
        auto it = pool->find(inputInt("ID студента: "));
        if (it == pool->end()) { cout << "Студент не найден\n"; return false; }
        x.student = &it->second;
        x.date = input("Дата: ");
        x.score = Score(inputInt("Баллы (0-100): "));
        return true;
    }
    static bool load(const vector<string>& f, TestResult& x) {
        if (f.size() < 3) return false;
        auto it = pool->find(stoi(f[0]));
        if (it == pool->end()) return false;
        x.student = &it->second;
        x.date = f[1];
        x.score = Score(stoi(f[2]));
        return true;
    }
};
map<int, Student>* TestResult::pool = nullptr;

