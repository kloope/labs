int inputInt(const string& msg) { try { return stoi(input(msg)); } catch (...) { return -1; } }

class Language {
public:
    string name, code;
    Language(string n = "", string c = "") : name(n), code(c) {}
    bool operator<(const Language& o) const { return name < o.name; } 
    static const char* header() { return "№\tЯзык\tКод"; }
    void printRow(ostream& o, int n) const { o << n << "\t" << name << "\t" << code << "\n"; }
    bool matches(const string& p) const { return name.find(p) != string::npos; }
    void edit() { code = input("Новый код: "); }
    bool sortLess(const Language& o) const { return code < o.code; }
    string fields() const { return name + "|" + code; }
    static bool create(Language& x) { x.name = input("Название: "); x.code = input("Код: "); return true; }
    static bool load(const vector<string>& f, Language& x) {
        if (f.size() < 2) return false;
        x = Language(f[0], f[1]);
        return true;
    }
};

class Person {
protected:
    string name;
public:
    Person(string n = "") : name(n) {}
    virtual ~Person() {}
    string getName() const { return name; }
    bool matches(const string& p) const { return name.find(p) != string::npos; }
};

class Student : public Person {
public:
    static int nextId;
    int id;
    string language;
    Student(int i = 0, string n = "", string l = "") : Person(n), id(i), language(l) {}
    int key() const { return id; }
    static const char* header() { return "№\tID\tФИО\tЯзык"; }
    void printRow(ostream& o, int n) const { o << n << "\t" << id << "\t" << name << "\t" << language << "\n"; }
    void edit() { name = input("Новое ФИО: "); language = input("Новый язык: "); }
    bool sortLess(const Student& o) const { return name < o.name; }
    string fields() const { return to_string(id) + "|" + name + "|" + language; }
    static bool create(Student& x) { x.id = nextId++; x.name = input("ФИО: "); x.language = input("Язык: "); return true; }
    static bool load(const vector<string>& f, Student& x) {
        if (f.size() < 3) return false;
        x = Student(stoi(f[0]), f[1], f[2]);
        nextId = max(nextId, x.id + 1);
        return true;
    }
};
int Student::nextId = 1;

